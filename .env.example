# Copy these into Cloudflare Pages → Settings → Variables (never put the
# service_role key here: the store only needs the public anon key).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
NEXT_PUBLIC_SITE_URL=https://nanobyte.pages.dev

# Local preview with sample products only. Never set this in production.
# NEXT_PUBLIC_DEMO=1
